# Local-only. Copy to `.env` and fill in. Never commit the real values.

# Path to ignored private JSON (aliases, allowlisted chat IDs, index/queue paths)
STAJ_ASISTAN_PRIVATE_CONFIG=data/private/config.json

# BotFather token. Required by the poller and by the send-button callback only.
TELEGRAM_BOT_TOKEN=

# Recommended for a private index. Hashing is tests-only unless --allow-hashing.
STAJ_ASISTAN_EMBEDDING_BACKEND=sentence-transformers

# Optional extras for the sample-ingest path (not used by corpus build)
# STAJ_ASISTAN_INSTRUCTOR_ALIASES=
# STAJ_ASISTAN_PRIVATE_HOSTS=
