# --- Privacy: never commit real participant data -----------------------------
data/private/*
!data/private/.gitkeep
data/raw/
*_chat.txt
*WhatsApp Chat*
*.zip
# Media exported from chats may contain personal photos
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.mp4
*.opus
*.ogg
*.m4a
*.pdf
*.docx
*.xlsx
!screenshots/.gitkeep
!data/private/.gitkeep
# Only screenshots/ may hold images, and only of the app running on sample data.
# Never commit a chat, desktop, editor or any capture showing real participants.
!screenshots/
!screenshots/*.png

# Local demo/review packages — screenshots and notes stay off the remote
review/

# --- Local vector index / model caches ---------------------------------------
.chroma/
chroma_db/
data/index/
*.faiss
*.index
.cache/
.hf_cache/
.sentence_transformers/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Environment / secrets ---------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# --- Editor / OS -------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
Thumbs.db

